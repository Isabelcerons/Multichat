# ===== Multichat: configuracion =====
# Conexion a PostgreSQL: cambia TU_CONTRASENA por la clave del usuario postgres (la que pusiste al instalar PostgreSQL).
# La base de datos "multichat" se crea sola.
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/multichat

# Embeddings: EmbeddingGemma servido por llama.cpp (iniciar.bat lo descarga y lo enciende en el puerto 8081)
EMBED_PROVIDER=llamacpp
LLAMACPP_EMBED_URL=http://localhost:8081

# Modelo que responde: ollama (local) | llamacpp | gemini (nube)
CHAT_PROVIDER=ollama
CHAT_MODEL=qwen2.5:1.5b
VISION_PROVIDER=ollama
VISION_MODEL=moondream
TRANSCRIBE_PROVIDER=local
WHISPER_MODEL=base

# Opcional: clave gratis de https://aistudio.google.com (tambien se puede poner en Ajustes)
# GEMINI_API_KEY=
